--- a/src/rime/gear/memory.h
+++ b/src/rime/gear/memory.h
@@ -12,6 +12,14 @@
 
 namespace rime {
 
+// Runtime switch a front-end can turn on to suspend personalized learning for
+// the current session: nothing is written to the user dictionary, and the user
+// dictionary is not consulted for candidates either. Android's
+// IME_FLAG_NO_PERSONALIZED_LEARNING -- raised by browsers in private/incognito
+// mode -- is what drives it. Nothing inside librime sets it, so an unset option
+// leaves the stock behaviour untouched.
+constexpr const char* kNoPersonalizedLearningOption = "_no_personalized_learning";
+
 class KeyEvent;
 class Context;
 class Engine;
