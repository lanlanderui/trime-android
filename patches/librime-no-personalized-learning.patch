+// Whether the front-end asked this session not to learn from what is typed.
+// A null context means the memory is not attached to an engine, which then has
+// no user dictionary to protect either.
+bool no_personalized_learning(Context* ctx) {
+  return ctx && ctx->get_option(kNoPersonalizedLearningOption);
